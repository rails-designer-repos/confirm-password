<%# locals: (id:, form_id:, input_name:, confirm_label: "Save") %>

<dialog id="<%= id %>" closedby="any" aria-labelledby="<%= id %>-heading" class="password-confirmation-dialog">
  <h2 id="<%= id %>-heading">Confirm your password</h2>
  <p>Enter your current password to continue.</p>

  <%= password_field_tag input_name, nil, form: form_id, autocomplete: "current-password", autofocus: true, placeholder: "•••••••••••••", "@keydown.enter": "submit:preventDefault", "@target": form_id %>

  <div class="buttons">
    <button type="button" @action="close" @target="<%= id %>" class="button-secondary">Cancel</button>
    <button type="submit" form="<%= form_id %>" data-turbo-submits-with="Saving" class="button-primary"><%= confirm_label %></button>
  </div>
</dialog>
